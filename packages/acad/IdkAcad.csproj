<Project Sdk="Microsoft.NET.Sdk">
  <!-- Плагин AutoCAD 2016 (R20.1, .NET Framework 4.6): ведомость объёмов работ и основная надпись листа схемы из Конструктора ИД. -->
  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>IdkAcad</AssemblyName>
    <RootNamespace>Idk.Acad</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="20.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="test/**" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
