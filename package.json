{
  "name": "konstruktor-id",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/addin",
    "packages/cloud"
  ],
  "scripts": {
    "test": "tsx --test \"packages/*/test/**/*.test.ts\"",
    "build": "node packages/addin/build.mjs && node packages/cloud/build.mjs",
    "start": "tsx packages/server/src/main.ts",
    "catalog:table": "tsx scripts/catalog-table.ts",
    "cloud": "tsx packages/cloud/src/main.ts",
    "build:cloud": "node packages/cloud/build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "@types/node": "26.2.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
